# Azure Blob Storage (Alphanumeric only, <= 24 chars: st{app}{env}{region})
AZURE_STORAGE_ACCOUNT_NAME="stvitalsdeveastus"
AZURE_STORAGE_CONTAINER_NAME="clinical-documents"
AZURE_STORAGE_CONNECTION_STRING=""

# Azure OpenAI Service (oai-{app}-{env}-{region})
AZURE_OPENAI_RESOURCE_NAME="oai-vitals-dev-eastus"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Standard OpenAI Fallback (Optional, if Azure OpenAI is pending approval)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Azure Functions & Logic Apps
AZURE_FUNCTION_NAME="func-vitals-extractor-dev"
AZURE_LOGIC_APP_NAME="logic-vitals-pipeline-dev"
LOGIC_APP_TRIGGER_URL=""

# PostgreSQL Database (Azure Database for PostgreSQL: psql-{app}-{env}-{region})
